# rctask: block direct access to config and docs.
# index.php in this folder redirects visitors to public/.
DirectoryIndex index.php

<IfModule mod_authz_core.c>
  <FilesMatch "^(config\.php|config\.sample\.php|README\.md|FEATURES\.md|\.gitignore)$">
    Require all denied
  </FilesMatch>
</IfModule>
