# If the whole rcphp folder is served (e.g. XAMPP htdocs), send visitors to
# public/ and block direct access to config and source files.
<FilesMatch "^(config\.php|config\.sample\.php|README\.md|\.gitignore)$">
  Require all denied
</FilesMatch>
RewriteEngine On
RewriteCond %{REQUEST_URI} !/public/
RewriteRule ^(.*)$ public/$1 [L]
